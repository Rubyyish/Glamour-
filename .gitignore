# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables
.env
.env.local
.env.development
.env.production
.env.*.local

# Build output
dist/
build/
.vite/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Lock files
package-lock.json
yarn.lock

# Media / uploads (exclude user uploads but keep static assets)
backend/public/textures/*.jpg
backend/public/textures/*.jpeg
backend/public/textures/*.png
backend/uploads/**/*.jpg
backend/uploads/**/*.jpeg
backend/uploads/**/*.png
backend/uploads/**/*.gif
backend/uploads/**/*.webm
backend/uploads/**/*.mp4

# Allow frontend public assets
!frontend/public/**/*.jpg
!frontend/public/**/*.jpeg
!frontend/public/**/*.png
!frontend/public/**/*.gif
!frontend/public/**/*.webm
!frontend/public/**/*.mp4

# Misc
storage.rules
