# Frontend Environment Variables
# Copy this file to .env and update with your values

# Backend API URL
VITE_API_URL=http://localhost:5001

# Snap Camera Kit / Lens Studio Configuration
# Get these from https://camera-kit.snapchat.com/
VITE_API_TOKEN=your_snap_api_token_here
VITE_LENS_ID=your_lens_id_here
VITE_LENS_GROUP_ID=your_lens_group_id_here
VITE_REMOTE_API_SPEC_ID=your_remote_api_spec_id_here
VITE_REMOTE_API_ENDPOINT_ID=get_image
